APP_NAME=Agentic RAG API
APP_ENV=dev
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000
CONTACT_EMAILS=dominberbel@gmail.com,info@domingoberbel.com
PROFESSIONAL_LINKEDIN=<linkedin-url>
ADMIN_READ_KEY=<clave-larga-admin>
SHOW_CITATIONS=false
MAX_REQUESTS_PER_MINUTE_PER_IP=20
MAX_TOKENS_PER_DAY=50000
TURNSTILE_SECRET_KEY=<turnstile-secret>

OPENAI_API_KEY=<tu-openai-api-key>
OPENAI_MODEL=gpt-4o-mini

AZURE_OPENAI_ENDPOINT=https://<tu-openai>.openai.azure.com
AZURE_OPENAI_API_KEY=<tu-api-key>
AZURE_OPENAI_API_VERSION=2024-10-21
AZURE_OPENAI_CHAT_DEPLOYMENT=<nombre-del-deployment>

AZURE_SEARCH_ENDPOINT=https://<tu-search>.search.windows.net
AZURE_SEARCH_API_KEY=<tu-search-key>
AZURE_SEARCH_INDEX_NAME=<tu-index>
