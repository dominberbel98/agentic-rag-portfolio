APP_NAME=Agentic RAG API
APP_ENV=dev
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

CONTACT_EMAILS=<tu-email@example.com>
PROFESSIONAL_LINKEDIN=<linkedin-url>
ADMIN_READ_KEY=<clave-larga-admin>
SHOW_CITATIONS=false
MAX_REQUESTS_PER_MINUTE_PER_IP=20
MAX_TOKENS_PER_DAY=50000
TURNSTILE_SECRET_KEY=<turnstile-secret>

# Generation
OPENAI_API_KEY=<tu-openai-api-key>
OPENAI_MODEL=gpt-5.6-luna

# Embeddings. Changing this model requires a full reindex:
#   python scripts/build_kb.py && python scripts/index_documents.py
# gemini-embedding-2's vector space is NOT compatible with gemini-embedding-001.
GOOGLE_API_KEY=<tu-google-api-key>
EMBEDDING_MODEL=gemini-embedding-2

# Retrieval and agent loop (defaults are fine; listed for visibility)
RETRIEVAL_TOP_K=6
AGENT_MAX_ITERATIONS=4
AGENT_MAX_TOOL_CALLS=6
AGENT_MAX_DOCUMENTS=8

# Index locations
EMBEDDINGS_CACHE_PATH=embeddings_cache.json
EMBEDDINGS_CACHE_FALLBACK=embeddings_cache.previous.json
VOCABULARY_PATH=data/kb/vocabulary.json

# NOTE: there is no Azure OpenAI or Azure AI Search configuration. Both resources
# were removed from the subscription; generation runs against the OpenAI API
# directly and retrieval runs against the local index built by scripts/.

# FUTBOARD storage — Neon Postgres. Use the -pooler host: Neon suspends
# the compute after 5 minutes idle and the pooler makes waking cheap.
# Optional. Unset means the FUTBOARD endpoints answer 503 and nothing
# else changes.
FUTBOARD_DATABASE_URL=
