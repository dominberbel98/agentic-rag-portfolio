FROM python:3.11-slim

WORKDIR /app

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

COPY app ./app
# Generated by scripts/build_kb.py and scripts/index_documents.py. The glob keeps
# the build working when they are absent, but the service then has no corpus to
# ground answers against — deploy_azure.sh checks for them before building.
COPY embeddings_cache.json* ./
COPY vocabulary.json* ./

# Run as non-root user to reduce attack surface
RUN useradd -m -u 1000 appuser && chown -R appuser:appuser /app
USER appuser

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
